# ملف البيئة لمنصّة المساعدين (ai-agent/.env على السيرفر — لا يُرفع إلى git)

# مفتاح التشفير الرئيسي (32 بايت hex) — ولّده مرة: openssl rand -hex 32
# لا تغيّره بعد التشغيل وإلا تتعطّل الجلسات ومفاتيح الإعدادات المحفوظة.
AI_MASTER_KEY=

# حساب المدير العام عند أول تشغيل فقط (يُطلب تغيير كلمة المرور عند أول دخول)
AI_ADMIN_USER=admin
AI_ADMIN_PASSWORD=
AI_ADMIN_NAME=المدير العام

# اختياري: مفتاح Claude احتياطي (الأفضل إضافته من لوحة الإدارة ← الإعدادات)
ANTHROPIC_API_KEY=
