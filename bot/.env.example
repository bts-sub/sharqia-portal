# ==========================================================================
#  إعدادات بوت تيليجرام «بيت العباءة الشرقية»
#  انسخ القيم إلى ملف .env على السيرفر (لا يُرفع إلى git إطلاقًا).
#  البوت يقرأ متغيّراته من نفس .env الخاص بالبوابة (env_file مشترك).
# ==========================================================================

# ---- توكن البوت من @BotFather (إلزامي) ----
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# ---- مفتاح Claude من Anthropic (إلزامي) ----
ANTHROPIC_API_KEY=sk-ant-...

# ---- موديل Claude (اختياري) ----
# الافتراضي متوازن (sonnet). للأرخص استخدم haiku، وللأقوى opus.
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_MAX_TOKENS=1500

# ---- التحكّم في الوصول ----
# ⚠️ مقفول افتراضيًا: لو لم تضبط أيًّا ممّا يلي (أدمن/قائمة/كود) يردّ البوت
#    «غير مصرّح لك» للجميع. البيانات سرّية فلا تتركها مفتوحة.
# BOT_ENABLED=false  → يوقف البوت مؤقتًا (زرّ الإيقاف) ويردّ باعتذار.
BOT_ENABLED=true
# BOT_ALLOWED_USERS: أرقام تيليجرام مفصولة بفواصل = القائمة البيضاء (الأشدّ إحكامًا).
BOT_ALLOWED_USERS=
# BOT_ACCESS_CODE: كود سرّي يرسله المستخدم مرّة ليُفعَّل (مناسب للإقلاع الأول).
BOT_ACCESS_CODE=
# BOT_ADMIN_CHAT_ID: رقمك في تيليجرام — مسموح دائمًا + يصله تنبيه بدء التشغيل.
BOT_ADMIN_CHAT_ID=

# ---- ذاكرة المحادثة ----
# عدد الرسائل (سؤال+رد) المحفوظة لكل محادثة لإبقاء السياق (كل زوج = رسالتان).
BOT_HISTORY_TURNS=10
