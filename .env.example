# ==========================================================================
#  إعدادات backend بوابة موظفي «بيت العباءة الشرقية»
#  انسخ هذا الملف إلى .env واملأ القيم الحقيقية. لا ترفع .env إلى git إطلاقًا.
# ==========================================================================

# ---- الخادم ----
PORT=4000                      # البورت (الواجهة تتوقّع 4000). طبّق آخر على 3001 مثلاً.
NODE_ENV=production            # production | development
COOKIE_SECURE=true             # true خلف HTTPS (Nginx+SSL). اجعله false للتجربة على http محلي.
CORS_ORIGIN=                   # اتركه فارغًا إذا كان الـ backend يقدّم الواجهة نفسها (نفس الأصل).
                               # أو ضع أصل الواجهة إن كانت مستضافة منفصلة، مثل: https://portal.example.sa

# ---- المصادقة المحلية (JWT) ----
JWT_SECRET=change-me-to-a-long-random-string   # ولّد قيمة عشوائية طويلة: openssl rand -hex 48
JWT_TTL_HOURS=12                               # مدة صلاحية جلسة الدخول بالساعات

# ---- أول حساب مدير نظام (seed) ----
ADMIN_EMAIL=admin@sharqia.sa
ADMIN_PASSWORD=change-me-strong-password       # يُنشَأ تلقائيًا عند أول تشغيل إن لم يوجد مستخدمون
ADMIN_NAME=مدير النظام

# ---- الاتصال بـ Odoo 19 (حساب خدمة واحد — لا يُسرّب للواجهة إطلاقًا) ----
ODOO_URL=https://odoo.example.sa    # عنوان خادم Odoo (بدون / في النهاية)
ODOO_DB=sharqia-prod                # اسم قاعدة بيانات Odoo
ODOO_USER=portal-bot@sharqia.sa     # مستخدم خدمة له صلاحيات HR المطلوبة فقط
ODOO_PASSWORD=odoo-api-key-or-pass  # كلمة مرور أو مفتاح API لمستخدم الخدمة
ODOO_UID_TTL_MIN=10                 # مدة كاش الـ uid بالدقائق (تجنّب إعادة المصادقة كل طلب)

# ---- وضع الاختبار ----
# true = يرجّع الـ backend بيانات تجريبية آمنة (fixtures) بدون لمس Odoo.
# false = بيانات حقيقية من Odoo. وإذا فشل الاتصال بأودو يسقط تلقائيًا لوضع الاختبار.
TEST_MODE=true

# ---- مسار الواجهة الثابتة (ملف HTML الواحد) ----
FRONTEND_FILE=public/index.html     # ضع ملف الواجهة هنا ليقدّمه الـ backend مباشرة

# ---- جسر التكامل مع Odoo (منصّة التحكّم في المستخدمين) ----
# مفتاح مشترك سرّي — نفس القيمة تُوضَع في Odoo (الإعدادات › بوابة الشرقية › المفتاح المشترك).
# يسمح لـ Odoo بإنشاء/تحديث المستخدمين وإرسال الإشعارات والإجراءات إلى هذا الخادم.
INTEGRATION_TOKEN=change-me-to-a-long-random-shared-secret

# ---- ملاحظة مهمة: ربط أودو ----
# بيانات أودو (ODOO_URL/DB/USER/PASSWORD) أصبحت اختيارية هنا.
# يُفضّل إدخالها من شاشة الدخول في التطبيق (تُحفظ بأمان على الخادم في data/odoo_creds.json).
# القيم أدناه تُستخدم فقط كاحتياطي لو لم تُدخل بيانات من الواجهة.
